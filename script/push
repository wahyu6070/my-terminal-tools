#!/usr/bin/env bash

# Sinkronkan repository, perbarui front matter lastmod, lalu push.
set -u

W='\033[0m'
R='\033[1;31m'
G='\033[1;32m'
C='\033[1;36m'
Y='\033[1;33m'
B='\033[1;34m'

TARGET_DIR="./content/game"
TIME_LIMIT_SEC=7200
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

echo -e "${C}======================================================${W}"
echo -e "${C}       SMART UPDATE LASTMOD & GIT PUSH${W}"
echo -e "${C}======================================================${W}"

if [[ ! -d .git ]]; then
    echo -e "${R}[ERROR] Direktori ini bukan repository Git.${W}" >&2
    exit 1
fi

if [[ ! -d "$TARGET_DIR" ]]; then
    echo -e "${R}[ERROR] Folder $TARGET_DIR tidak ditemukan.${W}" >&2
    exit 1
fi

echo -e "${B}[*] Menyinkronkan repository...${W}"
if ! git_pull_output=$(git pull --no-edit 2>&1); then
    echo -e "${R}[ERROR] Git pull gagal:${W}\n$git_pull_output" >&2
    exit 1
fi
echo "$git_pull_output"

if ! bash "$SCRIPT_DIR/update-lastmod" "$TARGET_DIR" "$TIME_LIMIT_SEC"; then
    echo -e "${R}[ERROR] Sebagian file gagal diperbarui.${W}" >&2
    exit 1
fi

if [[ -z "$(git status --porcelain)" ]]; then
    echo -e "${G}[INFO] Tidak ada perubahan; commit dan push dilewati.${W}"
    exit 0
fi

echo -e "${Y}[*] Menambahkan perubahan dan membuat commit...${W}"
git add . || exit 1
COMMIT_MSG="Auto-update content & lastmod: $(date '+%Y-%m-%d %H:%M:%S WIB')"
git commit -m "$COMMIT_MSG" || exit 1

echo -e "${B}[*] Mengunggah perubahan...${W}"
if git push; then
    echo -e "${G}[SUKSES] Sinkronisasi selesai.${W}"
else
    echo -e "${R}[ERROR] Git push gagal.${W}" >&2
    exit 1
fi
