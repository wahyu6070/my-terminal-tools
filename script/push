#!/usr/bin/env bash

# Perbarui front matter lastmod, lalu sinkronkan dengan remote secara aman.
set -u

W='\033[0m'
R='\033[1;31m'
C='\033[1;36m'

TARGET_DIR="./content/game"
TIME_LIMIT_SEC=21600
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

echo -e "${C}======================================================${W}"
echo -e "${C}       SMART UPDATE LASTMOD & GIT PUSH${W}"
echo -e "${C}======================================================${W}"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo -e "${R}[ERROR] Direktori ini bukan repository Git.${W}" >&2
    exit 1
fi

if [[ ! -d "$TARGET_DIR" ]]; then
    echo -e "${R}[ERROR] Folder $TARGET_DIR tidak ditemukan.${W}" >&2
    exit 1
fi

COMMIT_MSG="Auto-update content & lastmod: $(date '+%Y-%m-%d %H:%M:%S WIB')"
exec bash "$SCRIPT_DIR/git-sync" "$COMMIT_MSG" "$TARGET_DIR" "$TIME_LIMIT_SEC"
